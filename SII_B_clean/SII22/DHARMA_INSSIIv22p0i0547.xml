    <text xml:space="preserve">
        <body>
            
            <div type="edition">
                
                <p xml:lang="san-Latn" rendition="class:grantha maturity:vernacular">
                    <lb n="1"/>svastiśrī
                </p>
                <lg n="1" met="śārdūlavikrīḍita" xml:lang="san-Latn" rendition="class:grantha maturity:vernacular">
                    <l n="a">Āyuṣmannadhikendramāna nilaya tvatkirttimugdhāMbudhau</l>
                    <l n="b">trailokyaṁ kalavotapātramakhilammerurgguṇānoka haṁ</l>
                    <l n="c">taTkū 
                    <lb n="2" break="no"/>ṭeṣu kaṭāyate pariluḍanmeghāvalī pallavas</l>
                    <l n="d">tatratyastanute nirantaramiḷanmiyyāmatāmaryyamā <hi rend="check"><g ref="sym:tam-pillaiyarCuli" type="punctuation"/><!--Initial Grantha I in SII, but see both transcripts available on BharatSHRI.--></hi></l>
                </lg>
                
                <lg n="2" met="śārdūlavikrīḍita" xml:lang="san-Latn" rendition="class:grantha maturity:vernacular">
                    <l n="abcd">viraśrī laḷinatoyānamahita kṣmāpālacū
                    <lb n="3" break="no"/>ḍāmaṇi</l>
                    <l n="b">śreṇivāraṇa vāraṇa kramavidhā vāḷānasvāla drumaḥ</l>
                    <l n="c">śaśvattedhikamāna śatru dhavaḷacchatrendu biṁbagra<hi rend="check">ha<!--graha in SII, grahe in both transcripts available on BharatSHRI--></hi></l>
                    <l n="d">rāhurbāhu rasaṁhya sāhasa nidhirmdhattā
                    <lb n="4" break="no"/>ndharāmaṇḍalaM <g ref="sym:tam-pillaiyarCuli" type="punctuation"/></l>
               </lg>
                
                <lg n="3" met="śārdūlavikrīḍita" xml:lang="san-Latn" rendition="class:grantha maturity:vernacular">
                    <l n="a">śrīmaT keraḷa vaṁśabhūṣaṇa mitikhyātasya pṛdhvipater</l>
                    <l n="b">vyāmuttaśravaṇojvalasya mahato jaitrāsu dhātrāsuca</l>
                    <l n="c">nissāṇondhata bhīmanādamaniśanimma
                        <lb n="5" break="no"/>tvā mahābhoginaś</l><l n="d">śrimantosya vipakṣarāja bhujaṁgā nityā vināśaṁgatāḥ <g ref="sym:tam-pillaiyarCuli" type="punctuation"/></l>
                </lg>
                
                <lg n="4" met="uncertain" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                    <l n="1">ceraṉatikaṉ tiruneṭumāl teṉtakaṭai viraṉ viṭukātaḻakiyāṉ pāraḷantu ceṅ
                        <lb n="6" break="no"/>koṭupolac cilaiyai vaṭatikkaḷavuṅkaṅkoṭa veṭṭiṉāṉ kal <g ref="sym:tam-pillaiyarCuli" type="punctuation"/></l>
                </lg>
                
                <lg n="5" met="uncertain" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                    <l n="1">metiṉi nirveṇṭil viṭukātaḻakiyāṉ kotil pukaḻatikaṉ koyāṟṟūrāti vaṭaviru
                        <lb n="7" break="no"/>ṅ koḷiccarattil vaitta cilai mārpiliṭa viruṅkoḷa maṉṉaricaintu <g ref="sym:tam-pillaiyarCuli" type="punctuation"/></l>
                </lg>
                
            </div>
            
