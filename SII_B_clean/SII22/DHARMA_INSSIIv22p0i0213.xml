    <text xml:space="preserve">
        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <div type="textpart" n="A"><head>Piece A</head>
                
                <p>
                    <lb n="A1"/><hi rend="grantha">svasti śrī</hi> <supplied reason="undefined"><g ref="sym:doubleBar" type="punctuation">.</g></supplied> tiṅkaḷertaru taṉṟoṅkal veṇkuṭaikkiḻ nilamakaḷ nilava malar
                    <lb n="A2"/>ṟirupputalvar tammaiyum tuṉṟeḻil vāṉavaṉ villavaṉ miṉava
                    <lb n="A3"/>ṉṉupallūḻiyuṭṭeṉṉavar muvaru<unclear>ḷ māṉāpara</unclear>ṇaṉ maṇi
                    <lb n="A4"/>ppukaḻ cuntara<unclear>pāṇṭiyaṉ Oṟṟaive</unclear>
                </p>
                
                </div>
                
                <div type="textpart" n="B"><head>Piece B</head>
                
                <p>
                    <lb n="B1"/>valavaṉ kaṉṉa kucciyar kāvalaṉ Eṉa poṉ <gap reason="lost" quantity="4" unit="character"/> makuṭañcūṭṭip paṭar pukaḻāṅkavarkkavar 
                </p>
                
                </div>
                
                <div type="textpart" n="C"><head>Piece C</head>
                
                <p>
                    <lb n="C1"/><gap reason="lost"/> ṇṭiṟalaraicar vikkiyum vi
                    <lb n="C2" break="no"/><gap reason="lost"/> ppākkaiyuḷḷeri maṭuppit
                </p>
                
                </div>
                
                <div type="textpart" n="D"><head>Piece D</head>
                
                <p>
                    <lb n="D1" break="no"/><gap reason="lost"/> kkiyum vicaiyātittanunti
                    <lb n="D2" break="no"/><gap reason="lost"/> ṟorutaṉi taṇṭāṟ poruti
                </p>
                
                </div>
                
                <div type="textpart" n="E"><head>Piece E</head>
                <p>
                    <lb n="E1" break="no"/><gap reason="lost"/> nutaliṉar <hi rend="grantha">samarabhiru</hi>
                    <lb n="E2" break="no"/><gap reason="lost"/> ṟkimāvikka <gap reason="lost" quantity="4" unit="character"/> vi
                </p>
                
                </div>
                
                <div type="textpart" n="F"><head>Piece F</head>
                <p>
                    <lb n="F1" break="no"/><gap reason="lost"/> lavar veḻkulac caḷukkiyar vallavar
                    <lb n="F2" break="no"/><gap reason="lost"/> ṟavaraiyum kūṟukoḷ pocaḷa
                </p>
                
                </div>
                
                <div type="textpart" n="G"><head>Piece G</head>
                
                <p>
                    <lb n="G1" break="no"/><gap reason="lost"/> ṉaimuṉai vaiyi<unclear>ṟ piṭittu</unclear>
                    <lb n="G2" break="no"/><gap reason="lost"/>  <gap reason="lost" quantity="3" unit="character"/> ṉamum veṅkaḷattiḻa
                    <lb n="G3" break="no"/><gap reason="lost"/> tukki mevupukaḻ rāma
                    <lb n="G4" break="no"/><gap reason="lost"/> laikeḻu kān=taḷurccālai kalamaṟu
                    <lb n="G5" break="no"/><gap reason="lost"/>  <gap reason="lost" quantity="3" unit="character"/> ḷaiyuḷ kaṇṭappa<unclear>ya</unclear>
                    <lb n="G6" break="no"/><gap reason="lost"/>  <gap reason="lost" quantity="3" unit="character"/> piṉṉo payaṅ
                    <lb n="G7" break="no"/><gap reason="lost"/> neṉakkuṭainta
                    <lb n="G8" break="no"/><gap reason="lost" quantity="10" unit="character"/> 
                    <lb n="G9"/><gap reason="lost" quantity="10" unit="character"/> 
                    <lb n="G10"/><gap reason="lost" quantity="10" unit="character"/> 
                    <lb n="G11"/><gap reason="lost" quantity="10" unit="character"/> 
                    <lb n="G12"/><gap reason="lost" quantity="10" unit="character"/> 
                    <lb n="G13"/><gap reason="lost" quantity="10" unit="character"/> 
                    <lb n="G14"/><gap reason="lost"/> viṟṟirunta <hi rend="grantha">ja</hi>yaṅkoṇṭa
                    <lb n="G15"/><gap reason="lost" quantity="10" unit="character"/> 
                    <lb n="G16"/><gap reason="lost" quantity="10" unit="character"/> 
                    <lb n="G17"/><gap reason="lost"/> n celvaṉāna vira
                </p>
                
                </div>
                
                <div type="textpart" n="H"><head>Piece H</head>
                
                <p>
                    <lb n="H1" break="no"/><gap reason="lost"/> ṇṭā <gap reason="lost" quantity="4" unit="character"/> 
                    <lb n="H2"/><gap reason="lost"/> ṟaippe <gap reason="lost" quantity="4" unit="character"/> 
                    <lb n="H3"/><gap reason="lost"/> kāvalaṉai ten
                    <lb n="H4" break="no"/><gap reason="lost"/> yal laraicaraiya<hi rend="check">�<!--badly printed in the original--></hi>
                    <lb n="H5" break="no"/><gap reason="lost"/> ciṅkaḷar paṅkaḷar
                    <lb n="H6" break="no"/><gap reason="lost"/> <hi rend="grantha">viśva</hi>lokattu viḷaṅku maṉu
                    <lb n="H7" break="no"/><gap reason="lost"/> yar <hi rend="grantha">śrī rājādhirāja</hi>te 
                    <lb n="H8" break="no"/><gap reason="lost"/> mula<hi rend="grantha">sthā</hi>namuṭaiyāṟ kuṭika
                    <lb n="H9" break="no"/><gap reason="lost"/> vaitta pon <num value="23">2 <g type="numeral">10</g> 3</num> Ippo
                    <lb n="H10" break="no"/><gap reason="lost"/> ḷakku Ivviḷakku cantirā
                    <lb n="H11" break="no"/><gap reason="lost"/> <hi rend="grantha">brāhma</hi>ṇaṉirum <gap reason="lost" quantity="4" unit="character"/> 
                    <lb n="H12"/><gap reason="lost"/> kku nāṅkaḷ viṟṟukkuṭutta
                    <lb n="H13" break="no"/><gap reason="lost"/> nilattukku kiḻakku kāṇa
                    <lb n="H14" break="no"/><gap reason="lost"/> ṭārattu koṇṭu
                </p>
                
                </div>
                
                <div type="textpart" n="I"><head>Piece I</head>
                
                <p>
                    <lb n="I1" break="no"/><gap reason="lost"/> tukuvvaiyiṟ cey
                    <lb n="I2" break="no"/><gap reason="lost"/> ṉṟa nivanta Olai <gap reason="lost" quantity="2" unit="character"/> 
                    <lb n="I3"/><gap reason="lost"/> ttimaṇṭala Eriyilum
                    <lb n="I4" break="no"/><gap reason="lost"/>  <gap reason="lost" quantity="3" unit="character"/> ṅkaṇṭa nantā
                    <lb n="I5" break="no"/><gap reason="lost"/> ṟṟaiya <gap reason="lost" quantity="2" unit="character"/> kantukoṉ
                    <lb n="I6"/><gap reason="lost"/> pukaḻ kovirā<hi rend="grantha">ja</hi> kecari
                    <lb n="I7" break="no"/><gap reason="lost"/> nāṭṭu <hi rend="grantha">brahma</hi>teyam
                    <lb n="I8" break="no"/><gap reason="lost"/> yaṉ Ittevar paṇṭāra
                    <lb n="I9" break="no"/><gap reason="lost"/> kina kā<unclear>cu Āṟu</unclear> <gap reason="lost" quantity="3" unit="character"/> 
                    <lb n="I10"/> <gap reason="lost" quantity="10" unit="character"/> 
                    <lb n="I11"/><gap reason="lost"/> tenṟu kuṭut <gap reason="lost" quantity="4" unit="character"/> kuṭutta
                    <lb n="I12"/><gap reason="lost"/> llai Eṅkaḷūr <hi rend="grantha">śrī ko</hi>yi
                    <lb n="I13" break="no"/><gap reason="lost"/> <hi rend="grantha">dravya</hi>mum Iṟai<hi rend="grantha">dravya</hi>mum
                    <lb n="I14" break="no"/><gap reason="lost"/> yam Iṟuppatāṉom <hi rend="grantha">sa</hi>pai
                </p>
                    
                </div>
                
                
            </div>
            
