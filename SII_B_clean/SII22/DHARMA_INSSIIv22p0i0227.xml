    <text xml:space="preserve">
        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <div type="textpart" n="A"><head>Piece I</head>
                    
                    <p>
                        <lb n="A1"/><hi rend="grantha">svasti śrīmaN mahāmaṇḍa</hi>li<hi rend="grantha">śva</hi>ra
                        <lb n="A2"/>Arirāyavipāṭa pā<hi rend="grantha">ṣai</hi>kku
                        <lb n="A3"/>ttappuvarāyar kaṇṭaṉ <hi rend="grantha">śrī</hi>
                    </p>
                    
                </div>
                
                <div type="textpart" n="B"><head>Piece II</head>
                    
                    <p>
                        <lb n="B1"/>yar kumāra kampaṇa Uṭaiyar
                        <lb n="B2"/>kumāracommaṇa Uṭaiya<unclear>ṟku</unclear>
                        <lb n="B3"/>c cellāniṉṟa <hi rend="grantha">saumya</hi> <g ref="sym:tam-varusam"/>
                        <lb n="B4"/>Āṭimāta mutalukku Eyyil
                        <lb n="B5"/>Uṭaiyār tirumāṭaippeṟuṭaiya
                        <lb n="B6"/>nāyiṉāṟku tiruṉuntāviḷakku
                    </p>
                    
                </div>
                
                <div type="textpart" n="C"><head>Piece III</head>
                    
                    <p>
                        <lb n="C1"/>kuṭiyāka Aḻakapperumāḷ Āṉa
                        <lb n="C2"/>coṭṭaikkoṉai cantiṟātitta
                        <lb n="C3"/>varaikkum viṭṭom Ivai
                        <lb n="C4"/>tuvārapati veḷār Eḻuttu Ivai
                        <lb n="C5"/>perumāṅkoṉ Eḻuttu Ivai nila
                        <lb n="C6" break="no"/>kkoṉ Eḻuttu Ivai kaḷappāḷar Eḻu
                        <lb n="C7" break="no"/>ttu Ivai veṭṭaikkoṉ Eḻuttu <supplied reason="undefined"><g ref="sym:doubleBar" type="punctuation">.</g></supplied> 
                    </p>
                    
                </div>
                
            </div>
            
