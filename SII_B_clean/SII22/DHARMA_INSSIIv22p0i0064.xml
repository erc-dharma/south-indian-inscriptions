                    <lb n="4"/>paṇṭitaṉ cettavāṟe Eṅkaḷūr kuṉikkumpirāṉāṉa <hi rend="grantha">śai</hi>vavi<hi rend="grantha">jādhirabrahmamahārāja</hi>ṉum Ivaṉ ciṟṟappaṉ <hi rend="grantha">śai</hi>va<hi rend="grantha">ci</hi>ntā<hi rend="grantha">ma</hi>ṇi<hi rend="grantha"> <unclear>brahmama</unclear>hārāja</hi>ṉum taṅkaḷukkuk kāṇiyāka <gap reason="lost" quantity="6" unit="character"/> 
