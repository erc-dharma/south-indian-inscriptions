    <text xml:space="preserve">
        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <div type="textpart" n="A"><head>Piece 1</head>
                
                <p>
                    <lb n="A1"/><hi rend="grantha">svasti śrī</hi> tirumaṉ
                    <lb n="A2"/>ṉi vaḷara Iruṉilamaṭantai
                </p>
                
                </div>
                
                <div type="textpart" n="B"><head>Piece 2</head>
                
                <p>
                    <lb n="B1"/><hi rend="grantha">jentra</hi>coḻavaḷanā
                    <lb n="B2"/>ṇa<supplied reason="omitted">t</supplied>tāruḷ <hi rend="grantha">śrīmūla</hi>
                    <lb n="B3"/><hi rend="grantha">śrī</hi> Arumoḻi<hi rend="grantha">le</hi>
                    <lb n="B4"/>vatikku
                    <lb n="B5"/>ṇṇāṟṟu <unclear>Uṭ</unclear>tiruttu
                    <lb n="B6"/>patinaṟucāṇ ko
                    <lb n="B7"/><gap reason="lost" quantity="2" unit="character"/> Eḻumuḷūr mu <gap reason="lost" quantity="3" unit="character"/> 
                    <lb n="B8"/>vārip poṟṟivaṇniru
                    <lb n="B9"/><gap reason="lost" quantity="3" unit="character"/> <hi rend="grantha"> sahiraṇya</hi>
                </p>                
                
                </div>
                
                <div type="textpart" n="C"><head>Piece 3</head>                
                
                <p>
                    <lb n="C1"/>ḻatevice
                    <lb n="C2"/>kaiyyeḻuttu Ivvūriya
                    <lb n="C3"/>māvatu Ivvūr <hi rend="grantha">śrī</hi>kātā
                    <lb n="C4"/>kkālukku vaṭakku
                    <lb n="C5"/>t=tu tenkiḻakkaṭai
                    <lb n="C6"/>maṭucca tevak kaṇappe
                    <lb n="C7" break="no"/>vaṅkan ṉuyyapirān <hi rend="grantha">bha</hi>
                    <lb n="C8"/>naṟai <hi rend="grantha">śo</hi>mi<hi rend="grantha">śvarabha</hi>ṭṭa
                    <lb n="C9"/>Epperppaṭṭa Iṟaiyum
                    <lb n="C10"/>Itu <hi rend="grantha">panmāheśvara rakṣai</hi>
                </p>
                
                </div>
                
                <div type="textpart" n="D"><head>Piece 4</head>
                
                <p>
                    <lb n="D1"/>Āka kuḻi
                    <lb n="D2"/>nāna
                    <lb n="D3"/>ya koḷkaiyum
                    <lb n="D4"/>ḷiṭai vilai
                    <lb n="D5"/><hi rend="grantha">m<choice><sic>ā</sic><corr>a</corr></choice>h<unclear>ā</unclear>sabhai</hi>
                </p>
                    
                </div>
                
            </div>
            
            <div type="apparatus">
                
            </div>
            
            <div type="commentary">
                 <p>Two more pieces are quite fragmentary.</p> 
            </div>
            
