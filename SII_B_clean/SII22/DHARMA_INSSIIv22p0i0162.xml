            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <div type="textpart" n="A"><head>[[Part A]] TEXT</head>
                    <p>
                        <lb n="A1"/><hi rend="grantha">svasti śrīma</hi>ṉu māmaṇṭalicuraṉ Ari
                        <lb n="A2" break="no"/>rācavipāṭa pācaikku tappuvarāyar kaṇ
                        <lb n="A3" break="no"/>ṭa <hi rend="grantha">śrī</hi> kampaṇaUṭaiyaṟku tiruvirācciya
                        <lb n="A4" break="no"/><hi rend="grantha">M</hi> cellāniṉṟa piṟamāti varu<hi rend="grantha">ṣaM</hi> Uṭai
                        <lb n="A5" break="no"/>yār <unclear>Uṭaiyār</unclear> Ūrpākaṅkoṇṭaruḷiya nā
                        <lb n="A6" break="no"/>yaṉāṟku pañcakevikam ĀṭiAruḷa paruvūṟ kacciyarā
                        <lb n="A7" break="no"/>yar piḷḷaikaḷil kāḷattinātaṉ viṭṭa pacu Iraṇ
                        <lb n="A8" break="no"/>ṭum kaṉṟu tāyppacu muṉṟum Ākappacu Añ
                        <lb n="A9" break="no"/>cum cantiṟātittavaraiyum ĀṭiAruḷa Itu
                        <lb n="A10"/>mākecurar <hi rend="grantha">rakṣai</hi> <supplied reason="undefined"><g ref="sym:doubleBar" type="punctuation">.</g></supplied>
                    </p>
                </div>
                
                <div type="textpart" n="B">
                    
                    <head>[[Part B]] A.R. No. 162-A of 1906</head>
                    <p>
                        <lb n="B1"/>Uṭaiyār Ūrpākaṅkoṇṭaruḷiya nāyaṉāṟku
                        <lb n="B2"/><hi rend="grantha">śubhakṛT</hi> varu<hi rend="grantha">ṣaM</hi> paṅkuṉi mātam <num value="15"><g type="numeral">10</g> 5</num> <g ref="sym:tam-tiyati" type="ideogram">@</g> koppaṇṇa 
                        <lb n="B3" break="no"/>Uṭaiyar nirupappaṭikku cikkāṭṭuppaṟṟil citeviyil
                        <lb n="B4"/>vāṇātarāyaṉ Entalil piṟaiUṭaiyāṉ tiruvekam
                        <lb n="B5" break="no"/>pam Uṭaiyāṉ tirumuṭikkāri kuṭiniṅkāta tiruviḷakku
                        <lb n="B6" break="no"/>ppuṟa IṟaiyiliĀka viṭṭa tirununtāviḷakku Oṉṟuk<supplied reason="omitted">ku</supplied>
                        <lb n="B7"/>vāṇātarāyaṉ taṭi Oṉṟu kuḻi <num value="330">3 <g type="numeral">100</g> 3 <g type="numeral">10</g></num>-m piṟaiUṭaiyāṉ
                        <lb n="B8"/>taṭi Oṉṟu kuḻi <num value="220">2 <g type="numeral">100</g> 2 <g type="numeral">10</g></num>-m vaṭamelai mūlai kiṇaṟum viṭṭe<supplied reason="omitted">ṉ</supplied>
                        <lb n="B9"/>Itu tirumuṭikkāriyeṉ <hi rend="grantha">panmāheśvara rakṣai</hi> <supplied reason="undefined"><g ref="sym:doubleBar" type="punctuation">.</g></supplied>
                    </p>
                </div>
                
                
