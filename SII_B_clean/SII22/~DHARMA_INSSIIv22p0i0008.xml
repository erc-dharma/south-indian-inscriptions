    <text xml:space="preserve">
        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <div type="textpart" n="A"><head>Text (A)</head>
                    <p>
                        <lb n="A1"/>—ṅkarayaṉum I—
                        <lb n="A2"/>—ppatiyil vetanāyaka—
                        <lb n="A3"/>—tarai Umakkicaiyap <seg type="aksara"><seg type="component" subtype="body"><gap reason="lost" quantity="1" unit="component"/></seg>e</seg>—
                        <lb n="A4"/>—ppirān tātaṟku tirukuṭan—
                        <lb n="A5"/>—ṭalai tirukkaliveṉṟa tāta—
                    </p>                
                </div>
                
                <div type="textpart" n="B"><head>Text (B)</head>                
                    <p>
                        <lb n="B1"/>—ṭaikuṭi periyaperumāḷ tātar—
                        <lb n="B2"/>—raṅkanārāyaṇa tātaṟkum I—
                        <lb n="B3"/>—pen tiruvālinampikkum tā—
                        <lb n="B4"/>—ṭuttāruṭpaṭa paṅkukkum tiru—
                        <lb n="B5"/>—ttil Inta Akaram paṭṭarkaḷ—
                        <lb n="B6"/>—ṭatu Oru māvāka paṉṉi—
                        <lb n="B7"/>tile Aññūṟu kuḻi <seg type="aksara"><seg type="component" subtype="body"><gap reason="lost" quantity="1" unit="component"/></seg>e</seg>—
                    </p>
                    </div>
                
                <div type="textpart" n="B"><head>Text (C)</head>  
                    <p>
                        <lb n="C1"/><hi rend="grantha">—sti śrī</hi> tiripuvaṉaccakka—
                        <lb n="C2"/>—vāraikkal vetana—
                        <lb n="C3"/>—<gap reason="lost" quantity="2" unit="character"/> ya nāṭṭu vaṭakarai—
                        <lb n="C4"/>—lam Iraṇṭu māvum A—
                        <lb n="C5"/>—yili nilamāka paṉṉiru—
                        <lb n="C6"/>—l Iruveli nila<unclear>mu</unclear>m—
                        <lb n="C7"/>—ṟaiyili muṟṟu <gap reason="lost" quantity="2" unit="character"/> —
                        <lb n="C8"/>—ivvakarappa <gap reason="lost" quantity="4" unit="character"/> 
                    </p>
                    </div>
                
                <div type="textpart" n="B"><head>Text (D)</head>  
                    <p>
                        <lb n="D1"/>—tirumaṭaippaḷḷippuṟamāvatākavum—
                        <lb n="D2"/>—vetaṉ kāri māṟappirāṉ tātaṟkum tiru—
                        <lb n="D3"/>—ruppullāṇitātaṟku tiṭṭaikuṭi—
                        <lb n="D4"/>—yakan mātavan tiruvāli nampikkum—
                        <lb n="D5"/>—Utta<hi rend="grantha">ma</hi>nampikku miva<unclear>r ta</unclear>mpi Eṭut—
                        <lb n="D6"/>—vil Akarapaṭṭarkaḷukku<unclear>ceyvi</unclear>—
                    </p>
                    </div>
                
                <div type="textpart" n="B"><head>Text (E)</head>  
                    <p>
                        <lb n="E1"/>—vikkellai <gap reason="lost" quantity="4" unit="character"/> ṉ tampi teci Āḷap—
                        <lb n="E2"/>—muṭikolli <unclear>maḻai</unclear>nāṭṭut tiruvā<seg type="aksara"><seg type="component" subtype="body"><gap reason="lost" quantity="1" unit="component"/></seg>ai</seg>—
                        <lb n="E3"/>—koyilil <gap reason="lost" quantity="4" unit="character"/> tampiyum tiruman—
                        <lb n="E4"/>—karapaṭṭarkaḷ <hi rend="grantha">gau</hi>ta—
                        <lb n="E5"/>—celuttuvitāka—
                    </p>
                    
                </div>
                
