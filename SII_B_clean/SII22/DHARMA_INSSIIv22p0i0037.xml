                <div type="textpart" n="A">
                    <p>
                    <lb n="A1"/><hi rend="grantha">svasti śrī</hi> <supplied reason="undefined"><g ref="sym:doubleBar" type="punctuation">.</g></supplied> tiripuvanaccakkaravattikaḷ maturaikoṇṭaruḷiṉa <hi rend="grantha">śrī</hi>kulottuṅkacoḻatevaṟku yāṇṭu Oṉpatāvatu <hi rend="grantha">ja</hi>yaṅ<unclear>ko<!--kompu clear-->ṇṭacoḻa</unclear> vaḷanāṭṭu Ākkūrnāṭṭu tirukkaṭavūr Uṭaiyār <hi rend="grantha">śrī</hi>kālakālatevar
                    <lb n="A2"/>koyilil tirununtāviḷakku Eriya virutarā<hi rend="grantha">ja</hi>payaṅkaravaḷanāṭṭu nallāṟṟūr nāṭṭu mulaṅkuṭiyil kāṇiyuṭaiya Aṇai<unclear>kku</unclear>ṭaiyān cattivananāyakanāna tāna vinotappallavaraiyaṉ Ittevar tevatāṉam
                    <lb n="A3"/>Erukkāṭṭucceriyil maṇaṟkuṉṟil viḷainilamākak kallina kuḻi <num value="700">7 <g type="numeral">100</g></num> Eḻunūṟṟukkum nāḷ Oṉṟukku ney Uḻakkāka Onpatāvatu Āṉimātamutal cantirātittavaraiyum Erikka <hi rend="check"><g ref="sym:bullet-double" type="punctuation">.</g></hi> makataiyūruṭaiyāṉ p<choice><sic>a</sic><corr>ā</corr></choice>rantāṅkināṉāṉa kalikaṭinta coḻap
                    <lb n="A4"/>pallavaraiyaṉ vaitta tirununtāviḷakku 1 Oṉṟukkum Ittevar tevatāṉam Erukkāṭṭucceriyil maṇaṟkuṉṟil viḷainilamākak kallina kuḻi <num value="700">7 <g type="numeral">100</g></num> Eḻunūṟṟukkum <unclear>nāḷ</unclear> Oṉṟukku ney Uḻakkāka cantirātittavaraiyum Erikka <hi rend="check"><g ref="sym:bullet-double" type="punctuation">.</g></hi><g ref="sym:tam-pillaiyarCuli" type="punctuation">.</g>
                </p>
