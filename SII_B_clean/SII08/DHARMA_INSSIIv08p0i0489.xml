			<div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
				
				<p>
					<lb n="1"/><hi rend="grantha">śakāptaM</hi> Āyirattu munnūṟṟu nāliṉ mel cellāniṉṟa <hi rend="grantha">dundubhi</hi>varu<hi rend="grantha">ṣaM</hi> <gap reason="lost" quantity="6" unit="character"/> ya 3 <g ref="sym:tam-teti"/> canikkiḻamaiyum <hi rend="grantha">paurnam</hi>aiyum peṟṟa tiruvātirai nāḷ <hi rend="grantha">ja</hi>yaṅkoṇṭacoḻamaṇṭalattu
					
					<lb n="2"/>Āṟṟūrnāṭṭut tirukkāḷatti Āṉa mummuṭicoḻapurattu nāyaṉār tirukkāḷatti<unclear>Uṭaiya nā</unclear>yaṉārkku <hi rend="grantha">śrī</hi>ma<hi rend="grantha">Nmahāmaṇḍa</hi>le<hi rend="grantha">śva</hi>ra Arirāyavi<hi rend="grantha">bhāḷa bhāṣai</hi>kkuttappuva rāyarakaṇṭa <hi rend="grantha">mahi</hi>ta<hi rend="grantha">la</hi>pati <gap reason="lost" quantity="3" unit="character"/> <unclear>yirattu mu</unclear> <gap reason="lost" quantity="3" unit="character"/> 
					
					<lb n="3"/>veṇu<hi rend="grantha">bhā</hi>vā A<hi rend="grantha">jā</hi>vaṇa<hi rend="grantha">jā</hi>ni <hi rend="grantha">puṇya</hi>vaṇi<hi rend="grantha">jā</hi> <gap reason="lost" quantity="12" unit="character"/>  vā<hi rend="grantha">ha</hi>na <hi rend="grantha">gajasiṅga gaṇḍapeṇḍārūpa</hi>vaṇṭā<hi rend="grantha">rāca ji</hi>va<hi rend="grantha">rakṣa śaṅgemāsama</hi>ttar <hi rend="grantha">keskoṇḍamisa</hi> <gap reason="lost" quantity="2" unit="character"/> vī<hi rend="grantha">ramaṇḍaḷi</hi>
					
					<lb n="4" break="no"/><hi rend="grantha">kurā</hi>ya<hi rend="grantha">mīsarakaṇḍa</hi> <gap reason="lost" quantity="5" unit="character"/> <hi rend="grantha">kaḷāmaṇḍaḷiśara</hi> <gap reason="lost" quantity="10" unit="character"/> lā<hi rend="grantha">ḷarā</hi>ya<hi rend="grantha">bha</hi>ya<hi rend="grantha">ṅkara</hi> O<hi rend="grantha">śaḷada ḷa</hi>vi<hi rend="grantha">bhāḷa baḷaka</hi> <gap reason="lost" quantity="1" unit="character"/> <hi rend="grantha">ci</hi> <gap reason="lost" quantity="1" unit="character"/> <hi rend="grantha">mātyabhaṅga</hi> <gap reason="lost" quantity="10" unit="character"/>
					
					<lb n="5"/>vi<hi rend="grantha">bhā</hi>ḷa ciṅkalakkumārakaṇṭa <hi rend="grantha">śrī</hi>vīramaracappaUṭaiyār kumāra mallappaUṭaiyar <unclear>tiruvātirai</unclear> ma<hi rend="grantha">hā</hi>pūcaikku veṇṭum Avaiyiṟṟukku melaippaṭṭaiyanāṭṭu <gap reason="lost" quantity="10" unit="character"/> 
					
					<lb n="6"/>koṭṭikkāṭṭil pātiyāl Uḷḷa kaṭamai poṉvariyum tukkaṇar kāṇikkai <gap reason="lost" quantity="4" unit="character"/> kāṇikkai Uḷḷiṭṭa kāṇikkaivakaiyum maṟṟum Epperppaṭṭa cakala Upāti
					<lb n="7" break="no"/>kaḷum Uṭpaṭa <hi rend="grantha">sarvva</hi>māṉṉiyam Āka nāyaṉārkku tevatāṉam Āka ca<unclear>ntirātittavaraiyum</unclear> celvatāka viṭṭeṉ Inta mutal koṇṭu Intat tiruvātirai <hi rend="grantha">mahā</hi>pūcaiyum ca<hi rend="grantha">ntrādi</hi>tta
					
					<lb n="8" break="no"/>varaiyāka nammuṭaiya perāle naṭakkakkaṭavatākavum <supplied reason="subaudible"><g ref="sym:bar" type="punctuation">.</g></supplied> Inta ta<hi rend="grantha">rmma</hi>ttukku vi<hi rend="grantha">laṅ</hi>kam paṇṇiṉār Uṇṭākil keṅkaikkaraiyil kurālpacuvai koṉṟāṉ pā
					
					<lb n="9" break="no"/>vattile pokakkaṭavāṉ <supplied reason="subaudible"><g ref="sym:bar" type="punctuation">.</g></supplied> Itu paṉmā<hi rend="grantha">heśvara rakṣai</hi> <supplied reason="subaudible"><g ref="sym:doubleBar" type="punctuation">.</g></supplied>
				</p>
				
