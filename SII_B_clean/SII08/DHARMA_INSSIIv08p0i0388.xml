				<p>
					<lb n="1"/><g ref="sym:tam-pillaiyarCuli" type="punctuation"/><hi rend="grantha">śrīmaT kalyabdamaddhyē śaka</hi>
					<lb n="2" break="no"/><hi rend="grantha">nṛpakalitē vatsarē kāḷa</hi>
					<lb n="3" break="no"/><hi rend="grantha">yukt<choice><sic>a</sic><corr>au</corr></choice> sēt<choice><sic>a</sic><corr>au</corr></choice> sarvvāghaśā</hi>
					<lb n="4" break="no"/><hi rend="grantha">ntyai raghukulapatinā sthāpita</hi>
					<lb n="5" break="no"/><hi rend="grantha">syēśvarasya <supplied reason="subaudible"><g ref="sym:bar" type="punctuation">.</g></supplied> jīrṇaM prākārava</hi>
					<lb n="6" break="no"/><hi rend="grantha">ryyaM prathammabhinavaM mālikāmaṇḍa</hi>
					<lb n="7" break="no"/><hi rend="grantha">pēna cakrē śaivāgamārtthakrama</hi>
					<lb n="8" break="no"/><hi rend="grantha">vidhikuśalō rāmanāthō munīndraḥ</hi> <g ref="sym:bar" type="punctuation">.</g>
				</p>
				
