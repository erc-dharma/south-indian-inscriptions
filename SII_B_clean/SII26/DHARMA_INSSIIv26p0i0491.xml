            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <p>
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi> <supplied reason="undefined"><g ref="sym:doubleBar" type="punctuation">.</g></supplied> Emmaṇṭalamuṅ koṇṭaruḷiya <hi rend="grantha">śrī</hi>kulacekara<hi rend="grantha">de</hi>va<supplied reason="omitted">r</supplied>kku yāṇṭu patiṉeḻāvatu
                    <lb n="2"/><hi rend="grantha">tribhu</hi>vaṉa<hi rend="grantha">ca</hi>k<hi rend="grantha">ra</hi>vat=ti koneriṉmaikoṇṭāṉ maṇalūr vakuḷāparaṇapaṭṭaṟku tiruva
                    <lb n="3" break="no"/>ḻutivaḷanāṭṭu tirukkoyil poliñcuniṉṟaruḷiyaparama<hi rend="grantha">svā</hi>mikaḷukkum Āḻvār tirunāṭu⌈
                    <lb n="4" break="no"/>ṭaiyapirāṉukkum tarma <hi rend="grantha">I</hi>ti<hi rend="grantha">hāsa purā</hi>ṇaṅkaḷum vācittu ciṟappukkaḷukkum vācittu cu
                    <lb n="5" break="no"/><hi rend="grantha">ś</hi>lokaṅkaḷuñ colli Itukku muṉpupeṟṟup potumpaṭiyile nāḷoṉṟu
                    <lb n="6" break="no"/>kku muṉṟu <hi rend="grantha">prasāda</hi>mum Iraṇṭu Appamum Oru Akkāraiyum nālu tiruttampalamum
                    <lb n="7"/>Oru piṭikaḷaka <hi rend="grantha">prasāda</hi>mum to<supplied reason="omitted">ra</supplied>ṇamālaiyum māta U<hi rend="grantha">Tsa</hi>vaṅkaḷilum tirunāḷ ka<surplus>ḷ</surplus>ḷilum tiruva
                    <lb n="8" break="no"/>ttiyyaṉaṅkaḷilum ciṟappākap peṟṟu potum peṟupeṟukaḷun tāmun tammuṭaiyava<unclear>ṟ</unclear>
                    <lb n="9" break="no"/>kattārum vācittup peṟṟuppotavum Ippaṭi cantirātittava<hi rend="grantha">T</hi> celvatāka kallilum cem
                    <lb n="10" break="no"/>pilum veṭṭikkoḷḷavum pāṟka Ivai Āṉāntūruṭaiyāṉ Eḻuttu yāṇṭu patiṉeḻā
                    <lb n="11" break="no"/>vatu nāḷ <num value="346">3 <g type="numeral">100</g> 4 <g type="numeral">10</g> 6</num> Ivai yātavarāyaṉ Eḻuttu 1 Ivai paḻantivarāyaṉ Eḻuttu
                    <lb n="12"/><hi rend="grantha">svastyastu</hi> 
                </p>
                
